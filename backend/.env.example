# Copy to `.env` and adjust. Values here are safe local defaults.

# Application
APP_NAME=dubbing
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async driver required: sqlite+aiosqlite)
# Use an absolute path in production, e.g. sqlite+aiosqlite:////var/lib/dubbing/app.db
DATABASE_URL=sqlite+aiosqlite:///./dubbing.db
SQL_ECHO=false

# CORS: must be a JSON array when non-empty
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Auth
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
